{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subliminax",
  "main": "src/index.js",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "subliminax.com", "custom_domain": true },
    { "pattern": "www.subliminax.com", "custom_domain": true }
  ],
  // Vite SPA output — keeps Worker deploys serving the React build
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
